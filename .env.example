# Flask 設定
FLASK_SECRET_KEY=your-secret-key

# 全域搜尋條件（寄件者 OR 主旨，任一符合即可；可只填其中一項）
SEARCH_SENDER=example@gmail.com
SEARCH_SUBJECT=訂單通知

# 五組 Gmail 信箱設定（每組都需要應用程式密碼）
EMAIL_1_ADDRESS=email1@gmail.com
EMAIL_1_PASSWORD=app-password-1

EMAIL_2_ADDRESS=email2@gmail.com
EMAIL_2_PASSWORD=app-password-2

EMAIL_3_ADDRESS=email3@gmail.com
EMAIL_3_PASSWORD=app-password-3

EMAIL_4_ADDRESS=email4@gmail.com
EMAIL_4_PASSWORD=app-password-4

EMAIL_5_ADDRESS=email5@gmail.com
EMAIL_5_PASSWORD=app-password-5
